# ═══════════════════════════════════════════════════════════════
# CASHFLOW APP — Template Environment Variables
# Salin file ini ke `.env` dan sesuaikan nilainya.
# JANGAN commit file .env ke repository (sudah ada di .gitignore)
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Lokal (MAMP/XAMPP):
DATABASE_URL="mysql://root:root@localhost:3306/cashflow_perusahaan"
# Hostinger (ganti sesuai kredensial cPanel → MySQL Databases):
# DATABASE_URL="mysql://u123456789_cashflow:StrongP@ssw0rd!@localhost:3306/u123456789_cashflow"

# ── Server ───────────────────────────────────────────────────
# Port backend API (default 3001)
API_PORT=3001

# ── Node Environment ─────────────────────────────────────────
# Lokal: development | Production: production
NODE_ENV=development

# ── CORS (Production Only) ───────────────────────────────────
# Isi dengan domain Hostinger Anda saat deploy ke production.
# Kosongkan (atau hapus) untuk mode development (mengizinkan semua origin).
# ALLOWED_ORIGIN=https://kasirdomain.com
