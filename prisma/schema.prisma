  infaq
  seragam
  iuran_wisuda
  iuran_buku
  iuran_tahunan
  pendaftaran
  lain
}

enum cash_lunak_history_jenis {
  dp
  cicilan
  pelunasan
  lain
}

enum data_siswa_jenis_kelamin {
  L
  P
}

enum data_akad_status_cair {
  cair
  belum_cair
}

enum users_role {
  admin
  owner
  staff_bakso
  staff_amanah
  staff_batualam
  staff_kembang
  staff_perumahan
  staff_tkyaris
}

enum progres_tukang_status {
  belum_mulai
  berjalan
  selesai
  tertunda
}

enum users_status {
  aktif
  nonaktif
}

enum data_siswa_status {
  aktif
  lulus
  pindah
  nonaktif
}
