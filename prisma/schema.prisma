/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model transaksi_siswa {
  id                Int                              @id @default(autoincrement())
  siswa_id          Int
  tanggal_transaksi DateTime                         @db.Date
  jenis_pembayaran  transaksi_siswa_jenis_pembayaran
  periode_label     String                           @db.VarChar(50)
  periode_bulan     String?                          @db.VarChar(20)
  periode_tahun     String?                          @db.VarChar(10)
  tagihan           Decimal                          @db.Decimal(15, 2)
  jumlah_dibayar    Decimal                          @db.Decimal(15, 2)
  metode            String?                          @db.VarChar(50)
  bukti             String?                          @db.VarChar(255)
  keterangan        String?                          @db.Text
  created_by        Int?
  created_at        DateTime?                        @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                        @default(now()) @db.Timestamp(0)
  data_siswa        data_siswa                       @relation(fields: [siswa_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaksi_siswa")
  users             users?                           @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_transaksi_user")

  @@index([created_by], map: "idx_created_by")
  @@index([jenis_pembayaran], map: "idx_jenis")
  @@index([periode_tahun, periode_bulan], map: "idx_periode")
  @@index([siswa_id], map: "idx_siswa")
  @@index([tanggal_transaksi], map: "idx_tanggal")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                 Int                  @id @default(autoincrement())
  username           String               @unique(map: "uk_username") @db.VarChar(50)
  password           String               @db.VarChar(255)
  nama_lengkap       String               @db.VarChar(100)
  email              String?              @db.VarChar(100)
  no_hp              String?              @db.VarChar(20)
  role               users_role
  divisi_akses       String?              @db.VarChar(50)
  status             users_status?        @default(aktif)
  foto               String?              @db.VarChar(255)
  last_login         DateTime?            @db.DateTime(0)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  cash_lunak         cash_lunak[]
  data_akad          data_akad[]
  log_aktivitas      log_aktivitas[]
  progres_tukang     progres_tukang[]
  transaksi_cashflow transaksi_cashflow[]
  transaksi_siswa    transaksi_siswa[]

  @@index([role], map: "idx_role")
  @@index([status], map: "idx_status")
}

enum transaksi_cashflow_divisi {
  bakso
  amanah
  batualam
  kembang
  perumahan
  tkyaris
}

enum transaksi_siswa_jenis_pembayaran {
